---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import UpdateCard from "../../components/UpdateCard.astro";
import { withBase } from "../../utils/paths";
const updates = (await getCollection("updates", ({ data }) => data.challenge === "expert-system" && !data.draft)).sort((a, b) => b.data.week - a.data.week);
---
<BaseLayout title="Expert System" description="Challenge 01: building an explainable expert system for a financial decision.">
  <section class="challenge-hero">
    <div>
      <a class="back-link" href={withBase("challenges")}>← All challenges</a>
      <p class="eyebrow">Challenge 01 · Active</p>
      <h1>Expert<br/><em>System.</em></h1>
      <p class="hero-lead">Can explicit rules make a financial recommendation that is useful, testable, and honest about how it was reached?</p>
    </div>
    <div class="hero-art"><img src={withBase("hero-grid.svg")} alt="Abstract expert system and finance diagram"/></div>
  </section>
  <section id="journal" class="section journal"><div class="section-head"><div><p class="eyebrow">Progress log</p><h2>Weekly field notes.</h2></div><span class="count">{updates.length} entries</span></div><div class="updates-grid">{updates.map((entry) => <UpdateCard entry={entry}/>)}</div></section>
  <aside class="disclaimer"><strong>Project boundary</strong><p>This academic prototype does not provide financial advice. Rules, thresholds, and outputs must be independently validated before any real-world use.</p></aside>
</BaseLayout>