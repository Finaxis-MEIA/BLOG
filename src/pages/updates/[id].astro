---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Authors from "../../components/Authors.astro";
import { challengeBySlug } from "../../data/site";
import { withBase } from "../../utils/paths";
import { readingMinutes } from "../../utils/updates";
export async function getStaticPaths() {
  const entries = await getCollection("updates", ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry, entries } }));
}
const { entry, entries } = Astro.props;
const { Content } = await render(entry);
const challenge = challengeBySlug(entry.data.challenge);
const ordered = entries.filter((item) => item.data.challenge === entry.data.challenge).sort((a, b) => a.data.week - b.data.week);
const current = ordered.findIndex((item) => item.id === entry.id);
const previous = ordered[current - 1];
const next = ordered[current + 1];
const date = entry.data.date.toLocaleDateString("en-GB", { day: "2-digit", month: "long", year: "numeric", timeZone: "UTC" });
---
<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article class="article-page">
    <header class="article-header">
      <a class="back-link" href={withBase(`challenges/${entry.data.challenge}`)}>← {challenge?.title ?? "Challenge"} journal</a>
      <div class="article-kicker"><span>{challenge && <>Challenge {challenge.number} · </>}Week {String(entry.data.week).padStart(2, "0")} of {ordered.length}</span><span class:list={["status", entry.data.status === "completed" ? "completed" : "active"]}>{entry.data.status.replace("-", " ")}</span></div>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.summary}</p>
      <div class="byline"><Authors ids={entry.data.authors}/><span class="byline-date"><time datetime={entry.data.date.toISOString()}>{date}</time> · {readingMinutes(entry)} min read</span></div>
    </header>
    <div class="prose"><Content/></div>
    <nav class="article-nav" aria-label="Update navigation">
      {previous ? <a href={withBase(`updates/${previous.id}`)}><small>Previous · Week {String(previous.data.week).padStart(2, "0")}</small><span>← {previous.data.title}</span></a> : <span/>}
      {next ? <a class="next" href={withBase(`updates/${next.id}`)}><small>Next · Week {String(next.data.week).padStart(2, "0")}</small><span>{next.data.title} →</span></a> : <a class="next" href={withBase(`challenges/${entry.data.challenge}`)}><small>Latest week</small><span>All {challenge?.title} updates →</span></a>}
    </nav>
  </article>
</BaseLayout>
