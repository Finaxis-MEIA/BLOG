---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { memberName } from "../../data/members";
export async function getStaticPaths() {
  const entries = await getCollection("updates", ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry, entries } }));
}
const { entry, entries } = Astro.props;
const { Content } = await render(entry);
const ordered = [...entries].sort((a, b) => a.data.week - b.data.week);
const current = ordered.findIndex((item) => item.id === entry.id);
const previous = ordered[current - 1];
const next = ordered[current + 1];
const date = entry.data.date.toLocaleDateString("en-GB", { day: "2-digit", month: "long", year: "numeric" });
---
<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article class="article-page">
    <header class="article-header"><a class="back-link" href="/challenges/expert-system">← Expert System journal</a><div class="article-kicker"><span>Week {String(entry.data.week).padStart(2, "0")}</span><span class:list={["status", entry.data.status === "completed" ? "active" : "upcoming"]}>{entry.data.status.replace("-", " ")}</span></div><h1>{entry.data.title}</h1><p>{entry.data.summary}</p><div class="byline"><time datetime={entry.data.date.toISOString()}>{date}</time><span>{entry.data.authors.map(memberName).join(" · ")}</span></div></header>
    <div class="prose"><Content/></div>
    <nav class="article-nav" aria-label="Update navigation">{previous ? <a href={`/updates/${previous.id}`}><small>Previous</small><span>← {previous.data.title}</span></a> : <span/>}{next ? <a class="next" href={`/updates/${next.id}`}><small>Next</small><span>{next.data.title} →</span></a> : <span/>}</nav>
  </article>
</BaseLayout>
