---
import BaseLayout from "../layouts/BaseLayout.astro";
import { members } from "../data/members";
import { withBase } from "../utils/paths";
---
<BaseLayout title="About us" description="Meet the six students behind Finaxis.">
  <section class="page-hero about-hero"><h1>About us</h1><p>We are six students in the Master's in AI Engineering.</p></section>
  <section class="team-grid">
    {members.map((member, index) => (
      <article class="member-card">
        <div class={`portrait portrait-${index + 1} ${member.photo ? "has-photo" : ""}`}>
          {member.photo ? (
            <img src={withBase(member.photo)} alt={`${member.name} profile photo`} class="member-photo" />
          ) : (
            <>
              <span>{member.initials}</span>
            </>
          )}
        </div>
        <div class="member-content">
          <span class="member-index">0{index + 1}</span>
          <p class="role">{member.role}</p>
          <h2>{member.name}</h2>
          <p>{member.background}</p>
          <div class="tag-list">{member.skills.map((skill) => <span>{skill}</span>)}</div>
          <div class="member-links">
            <a href={`mailto:${member.email}`}>Email</a>
            <a href={member.linkedin}>LinkedIn</a>
            <a href={member.github}>GitHub</a>
          </div>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
