---
import { withBase } from "../utils/paths";
const path = Astro.url.pathname;
const links = [{ href: withBase(), label: "Journal" }, { href: withBase("challenges"), label: "Challenges" }, { href: withBase("about"), label: "About us" }];
---
<header class="site-header">
  <a class="brand" href={withBase()} aria-label="Finaxis home"><img src={withBase("logo.svg")} alt="" width="44" height="44"/><span>Finaxis</span></a>
  <div class="header-right">
    <nav aria-label="Main navigation">
      {links.map((link) => <a href={link.href} aria-current={path === link.href || (link.href !== withBase() && path.startsWith(link.href)) ? "page" : undefined}>{link.label}</a>)}
    </nav>
    <button class="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false" data-theme-toggle>
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
  </div>
</header>
<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const sync = () => {
    const dark = root.dataset.theme === "dark";
    button?.setAttribute("aria-pressed", String(dark));
    button?.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
  };
  const apply = (next: string) => {
    root.dataset.theme = next;
    try { localStorage.setItem("finaxis-theme", next); } catch {}
    sync();
  };
  sync();
  button?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.classList.add("theme-switched");
    const startViewTransition = (document as any).startViewTransition?.bind(document);
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return apply(next);
    if (!startViewTransition) {
      // Older browsers: cross-fade the colours instead of the circular reveal.
      root.classList.add("theme-fade");
      apply(next);
      window.setTimeout(() => root.classList.remove("theme-fade"), 450);
      return;
    }
    const rect = button.getBoundingClientRect();
    const x = rect.left + rect.width / 2;
    const y = rect.top + rect.height / 2;
    const radius = Math.hypot(Math.max(x, window.innerWidth - x), Math.max(y, window.innerHeight - y));
    startViewTransition(() => apply(next)).ready.then(() => {
      root.animate(
        { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
        { duration: 550, easing: "cubic-bezier(0.65, 0, 0.35, 1)", pseudoElement: "::view-transition-new(root)" }
      );
    });
  });
</script>
