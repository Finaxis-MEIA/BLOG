---
import { withBase } from "../utils/paths";
const path = Astro.url.pathname;
const links = [{ href: withBase(), label: "Journal" }, { href: withBase("challenges"), label: "Challenges" }, { href: withBase("about"), label: "About us" }];
---
<header class="site-header">
  <a class="brand" href={withBase()} aria-label="Finaxis home"><img src={withBase("logo.svg")} alt="" width="44" height="44"/><span>Finaxis</span></a>
  <nav aria-label="Main navigation">
    {links.map((link) => <a href={link.href} aria-current={path === link.href || (link.href !== withBase() && path.startsWith(link.href)) ? "page" : undefined}>{link.label}</a>)}
  </nav>
</header>
